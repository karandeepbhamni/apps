{
  "name": "zakariya-dola-downloader",
  "version": "1.0.0",
  "description": "Zakariya Dola 1080P Downloader (Desktop)",
  "main": "main.js",
  "author": "Zakariya",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zakariya.dola",
    "productName": "Zakariya Dola Downloader",
    "files": ["main.js", "preload.js", "zk-page.js", "package.json"],
    "directories": { "buildResources": "build" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
